{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "erasableSyntaxOnly": true,

    // Referenced by tsconfig.test.json so features/*.steps.ts can import
    // src/domain under `tsc -b`'s composite-project rules: a referencing
    // project resolves a referenced project's types from its declaration
    // output, not its source, so this project needs *some* declaration
    // emit. Declaration-only, into a gitignored scratch dir — `vite build`
    // bundles src/ directly from source and never reads these .d.ts files,
    // so this has no effect on the production build.
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/app-dts"
  },
  "include": ["src"]
}
