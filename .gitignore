node_modules/
dist/
.env.local
.env.*.local
# Backups/swaps of the credentials file — `.env.local` itself was covered but
# `.env.local.bak`, `.env.local~`, editor swapfiles etc. were not, so a stray
# copy of real credentials could be committed by a careless `git add -A`.
.env.local.*
.env.local~
!.env.local.example
