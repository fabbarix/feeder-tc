{
  "name": "feeder-tc",
  "version": "0.0.0",
  "description": "Household meal planner - GitHub Pages + Google Sheets backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm run lint:css && npm run contrast-sweep && npm run mock-parity",
    "lint:css": "stylelint \"src/**/*.css\"",
    "contrast-sweep": "node scripts/contrast-sweep.mjs",
    "mock-parity": "node scripts/mock-parity.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabbarix/feeder-tc.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fabbarix/feeder-tc/issues"
  },
  "homepage": "https://github.com/fabbarix/feeder-tc#readme",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-stately": "^3.49.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
